<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FindCall0/FindCall0.fs" />
    <Compile Include="FindCall0/FindCall0Invalid.fs" />
    <Compile Include="Return64Detection/Return64Types.fs" />
    <Compile Include="Return64Detection/Analysis/StatementIndex.fs" />
    <Compile Include="Return64Detection/Analysis/RangeSelector.fs" />
    <Compile Include="Return64Detection/Analysis/ExitVersionAnalyzer.fs" />
    <Compile Include="Return64Detection/Analysis/UseChainClassifier.fs" />
    <Compile Include="Return64Detection/BasicDetector.fs" />
    <Compile Include="Return64Detection/CallerChecker.fs" />
    <Compile Include="Return64Detection/Return64Detector.fs" />
    <Compile Include="Return64Detection/Return64Formatter.fs" />
    <Compile Include="Return64Detection/Evaluator/EvaluatorTypes.fs" />
    <Compile Include="Return64Detection/Evaluator/GroundTruthParser.fs" />
    <Compile Include="Return64Detection/Evaluator/ElementEvaluator.fs" />
    <Compile Include="Return64Detection/Evaluator/EvalMetric.fs" />
    <Compile Include="Return64Detection/Evaluator/EvalLog.fs" />
    <Compile Include="Return64Detection/Evaluator/Evaluator.fs" />
    <Compile Include="EvaluateAnalyzer/GroundTruthExtractor/Dwarf/PyDwarfCommand.fs" />
    <Compile Include="EvaluateAnalyzer/GroundTruthExtractor/GroundTruthBuilder.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvaluatorTypes.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvaluatorParseJson.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/ElementEvaluator.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvalMetric.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvalLog.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/Evaluator.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <ProjectReference Include="../src/PointerAnalyzer.fsproj" />
  </ItemGroup>

</Project>
