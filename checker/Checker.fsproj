<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FindCall0/FindCall0.fs" />
    <Compile Include="FindCall0/FindCall0Invalid.fs" />
    <Compile Include="EvaluateAnalyzer/GroundTruthExtractor/Dwarf/PyDwarfCommand.fs" />
    <Compile Include="EvaluateAnalyzer/GroundTruthExtractor/GroundTruthBuilder.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvaluatorTypes.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvaluatorParseJson.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/ElementEvaluator.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvalMetric.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/EvalLog.fs" />
    <Compile Include="EvaluateAnalyzer/Evaluator/Evaluator.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Argu" Version="6.2.5" />
    <ProjectReference Include="../external/B2R2/src/FrontEnd/API/B2R2.FrontEnd.API.fsproj" />
    <ProjectReference Include="../external/B2R2/src/MiddleEnd/API/B2R2.MiddleEnd.API.fsproj" />
  </ItemGroup>

</Project>
